{
  "type": "object",
  "properties": {
    "startUrls": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "searchQueries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxPagesPerDomain": {
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 50
    },
    "maxDepth": {
      "type": "integer",
      "default": 2,
      "minimum": 0,
      "maximum": 5
    },
    "maxResults": {
      "type": "integer",
      "default": 20,
      "minimum": 1,
      "maximum": 500
    },
    "proxyConfig": {
      "type": "object",
      "const": {
        "useApifyProxy": false
      },
      "default": {
        "useApifyProxy": false
      }
    }
  },
  "required": [
    "proxyConfig"
  ],
  "additionalProperties": false,
  "title": "contact-details-scraper: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
