{
  "$schema": "https://apify.com/schemas/v1/input.ide.json",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "crawl",
        "list",
        "sitemap"
      ],
      "default": "crawl"
    },
    "startUrl": {
      "type": "string",
      "allOf": [
        {
          "not": {
            "pattern": "^\\s*[hH][tT][tT][pP][sS]?://[^/?#]*(?:@|%40)"
          }
        }
      ]
    },
    "urls": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "string",
            "pattern": "^https?:\\/\\/.+"
          },
          {
            "not": {
              "type": "string",
              "pattern": "^\\s*[hH][tT][tT][pP][sS]?://[^/?#]*(?:@|%40)"
            }
          }
        ]
      }
    },
    "maxPages": {
      "type": "integer",
      "default": 50,
      "minimum": 1,
      "maximum": 5000
    },
    "maxLinksToCheck": {
      "type": "integer",
      "default": 500,
      "minimum": 1,
      "maximum": 10000
    },
    "checkExternalLinks": {
      "type": "boolean",
      "default": true
    },
    "checkAssets": {
      "type": "boolean",
      "default": false
    },
    "onlyReportBroken": {
      "type": "boolean",
      "default": true
    },
    "slowThresholdMs": {
      "type": "integer",
      "default": 5000,
      "minimum": 100,
      "maximum": 60000
    },
    "requestTimeoutMs": {
      "type": "integer",
      "default": 15000,
      "minimum": 1000,
      "maximum": 60000
    },
    "maxConcurrency": {
      "type": "integer",
      "default": 20,
      "minimum": 1,
      "maximum": 100
    },
    "maxRedirects": {
      "type": "integer",
      "default": 10,
      "minimum": 0,
      "maximum": 30
    },
    "proxyConfiguration": {
      "type": "object",
      "const": {
        "useApifyProxy": false
      },
      "default": {
        "useApifyProxy": false
      }
    }
  },
  "required": [
    "mode",
    "proxyConfiguration"
  ],
  "additionalProperties": false,
  "title": "broken-link-checker: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
