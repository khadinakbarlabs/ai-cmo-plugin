{
  "type": "object",
  "properties": {
    "videoUrls": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "channelUrl": {
      "type": "string",
      "allOf": [
        {
          "not": {
            "pattern": "^\\s*[hH][tT][tT][pP][sS]?://[^/?#]*(?:@|%40)"
          }
        }
      ]
    },
    "searchQuery": {
      "type": "string"
    },
    "maxResults": {
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 500
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "dateFrom": {
      "type": "string"
    },
    "dateTo": {
      "type": "string"
    },
    "includeMetadata": {
      "type": "boolean",
      "default": true
    },
    "outputFormat": {
      "type": "string",
      "default": "all",
      "enum": [
        "all",
        "segments",
        "plain_text",
        "srt"
      ]
    }
  },
  "required": [],
  "additionalProperties": false,
  "title": "youtube-transcript-extractor: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
