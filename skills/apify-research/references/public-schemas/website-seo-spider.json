{
  "$schema": "https://apify.com/schemas/v1/input.ide.json",
  "type": "object",
  "required": [
    "fetchMode",
    "proxyConfiguration",
    "respectRobotsTxt",
    "startUrls"
  ],
  "properties": {
    "startUrls": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "crawlScope": {
      "type": "string",
      "enum": [
        "same-hostname",
        "same-domain",
        "page-only"
      ],
      "default": "same-hostname"
    },
    "maxPages": {
      "type": "integer",
      "default": 100,
      "minimum": 1,
      "maximum": 2000
    },
    "maxDepth": {
      "type": "integer",
      "default": 10,
      "minimum": 0,
      "maximum": 20
    },
    "seedFromSitemap": {
      "type": "boolean",
      "default": false
    },
    "respectRobotsTxt": {
      "type": "boolean",
      "default": true,
      "const": true
    },
    "ignoreUrlParameters": {
      "type": "boolean",
      "default": false
    },
    "maxConcurrency": {
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "maximum": 20
    },
    "fetchMode": {
      "type": "string",
      "enum": [
        "direct"
      ],
      "default": "direct"
    },
    "proxyConfiguration": {
      "type": "object",
      "const": {
        "useApifyProxy": false
      },
      "default": {
        "useApifyProxy": false
      }
    }
  },
  "additionalProperties": false,
  "title": "website-seo-spider: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
