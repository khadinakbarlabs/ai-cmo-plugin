{
  "type": "object",
  "properties": {
    "targetDomain": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "targetUrls": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "string"
          },
          {
            "not": {
              "type": "string",
              "pattern": "^\\s*[hH][tT][tT][pP][sS]?://[^/?#]*(?:@|%40)"
            }
          }
        ]
      }
    },
    "competitorDomains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platforms": {
      "type": "array",
      "default": [
        "perplexity",
        "chatgpt",
        "gemini"
      ],
      "items": {
        "type": "string"
      }
    },
    "queryTemplates": {
      "type": "array",
      "default": [
        "topic_authority",
        "how_to",
        "what_is"
      ],
      "items": {
        "type": "string"
      }
    },
    "customQueries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maxQueriesPerKeyword": {
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "maximum": 10
    },
    "responseFormat": {
      "type": "string",
      "enum": [
        "concise",
        "detailed"
      ],
      "default": "detailed"
    },
    "demoMode": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [],
  "additionalProperties": false,
  "title": "ai-search-visibility-tracker: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
