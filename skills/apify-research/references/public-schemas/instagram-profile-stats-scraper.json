{
  "$schema": "https://apify.com/schemas/v1/input.ide.json",
  "type": "object",
  "properties": {
    "usernames": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deduplicate": {
      "type": "boolean",
      "default": true
    },
    "maxItems": {
      "type": "integer",
      "default": 500,
      "minimum": 1
    },
    "maxRequestRetries": {
      "type": "integer",
      "default": 2,
      "minimum": 0,
      "maximum": 10
    },
    "requestTimeoutSecs": {
      "type": "integer",
      "default": 30,
      "minimum": 10,
      "maximum": 120
    }
  },
  "required": [
    "usernames"
  ],
  "additionalProperties": false,
  "title": "instagram-profile-stats-scraper: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
