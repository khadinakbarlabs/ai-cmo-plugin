{
  "type": "object",
  "properties": {
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetDomain": {
      "type": "string"
    },
    "opportunityTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "resource_page",
          "guest_post",
          "listicle",
          "directory",
          "podcast",
          "expert_roundup"
        ]
      }
    },
    "excludeDomains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "countryCode": {
      "type": "string",
      "default": "US"
    },
    "languageCode": {
      "type": "string",
      "default": "en"
    },
    "maxResultsPerKeyword": {
      "type": "integer",
      "default": 25,
      "minimum": 1,
      "maximum": 100
    },
    "maxPagesPerQuery": {
      "type": "integer",
      "default": 1,
      "minimum": 1,
      "maximum": 5
    },
    "minimumRelevanceScore": {
      "type": "integer",
      "default": 35,
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "keywords"
  ],
  "additionalProperties": false,
  "title": "backlink-opportunity-finder: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
