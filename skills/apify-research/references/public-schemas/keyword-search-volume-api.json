{
  "$schema": "https://apify.com/schemas/v1/input.ide.json",
  "type": "object",
  "properties": {
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "mode": {
      "type": "string",
      "default": "free_tier",
      "enum": [
        "free_tier",
        "bulk_paid"
      ]
    },
    "countryName": {
      "type": "string",
      "default": "United States"
    },
    "languageName": {
      "type": "string",
      "default": "English"
    },
    "includeCompetition": {
      "type": "boolean",
      "default": true
    },
    "includeLowTopOfPageBid": {
      "type": "boolean",
      "default": true
    },
    "includeHighTopOfPageBid": {
      "type": "boolean",
      "default": true
    },
    "maxKeywordsPerBatch": {
      "type": "integer",
      "default": 700,
      "minimum": 1,
      "maximum": 1000
    },
    "onPartialFailure": {
      "type": "string",
      "default": "return_partial",
      "enum": [
        "return_partial",
        "fail_if_any_batch_fails"
      ]
    }
  },
  "required": [
    "keywords"
  ],
  "additionalProperties": false,
  "title": "keyword-search-volume-api: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
