{
  "type": "object",
  "properties": {
    "startUrls": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "maxPagesPerDomain": {
      "type": "integer",
      "default": 6,
      "minimum": 1,
      "maximum": 20
    },
    "maxResults": {
      "type": "integer",
      "default": 1000,
      "minimum": 0
    },
    "followContactPages": {
      "type": "boolean",
      "default": true
    },
    "proxyConfiguration": {
      "type": "object",
      "const": {
        "useApifyProxy": false
      },
      "default": {
        "useApifyProxy": false
      }
    }
  },
  "required": [
    "proxyConfiguration",
    "startUrls"
  ],
  "additionalProperties": false,
  "title": "bulk-website-contact-extractor: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
