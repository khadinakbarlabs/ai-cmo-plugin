{
  "type": "object",
  "properties": {
    "searchQuery": {
      "type": "string"
    },
    "searchType": {
      "type": "string",
      "enum": [
        "domain",
        "advertiserName"
      ],
      "default": "domain"
    },
    "countryCode": {
      "type": "string",
      "default": "US"
    },
    "adFormat": {
      "type": "string",
      "enum": [
        "ALL",
        "TEXT",
        "IMAGE",
        "VIDEO"
      ],
      "default": "ALL"
    },
    "maxResults": {
      "type": "integer",
      "default": 50,
      "minimum": 1,
      "maximum": 1000
    },
    "startUrls": {
      "type": "array",
      "default": [],
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "enrichDetails": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [],
  "additionalProperties": false,
  "title": "google-ads-transparency-scraper: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
