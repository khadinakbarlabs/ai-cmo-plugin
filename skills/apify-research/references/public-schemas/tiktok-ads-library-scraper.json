{
  "$schema": "https://apify.com/schemas/v1/input.ide.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "libraryUrl": {
      "type": "string",
      "maxLength": 4096,
      "allOf": [
        {
          "not": {
            "pattern": "^\\s*[hH][tT][tT][pP][sS]?://[^/?#]*(?:@|%40)"
          }
        }
      ]
    },
    "country": {
      "type": "string",
      "enum": [
        "AT",
        "BE",
        "BG",
        "CH",
        "CY",
        "CZ",
        "DE",
        "DK",
        "EE",
        "ES",
        "FI",
        "FR",
        "GB",
        "GR",
        "HR",
        "HU",
        "IE",
        "IS",
        "IT",
        "LI",
        "LT",
        "LU",
        "LV",
        "MT",
        "NL",
        "NO",
        "PL",
        "PT",
        "RO",
        "SE",
        "SI",
        "SK"
      ],
      "default": "DE"
    },
    "searchQuery": {
      "type": "string",
      "maxLength": 200,
      "default": "adidas"
    },
    "searchType": {
      "type": "string",
      "enum": [
        "keyword",
        "advertiser"
      ],
      "default": "keyword"
    },
    "advertiserBusinessId": {
      "type": "string",
      "maxLength": 30,
      "pattern": "^$|^[0-9]{1,30}$"
    },
    "dateFrom": {
      "type": "string",
      "maxLength": 10,
      "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateTo": {
      "type": "string",
      "maxLength": 10,
      "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "maxResults": {
      "type": "integer",
      "default": 20,
      "minimum": 1,
      "maximum": 200
    },
    "includeDetails": {
      "type": "boolean",
      "default": false
    },
    "requestTimeoutSecs": {
      "type": "integer",
      "default": 60,
      "minimum": 20,
      "maximum": 120
    }
  },
  "required": [],
  "title": "tiktok-ads-library-scraper: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
