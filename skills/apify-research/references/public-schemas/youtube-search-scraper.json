{
  "type": "object",
  "properties": {
    "searchQueries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxResultsPerQuery": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000,
      "default": 50
    },
    "resultType": {
      "type": "string",
      "enum": [
        "all",
        "video",
        "channel",
        "playlist",
        "movie"
      ],
      "default": "all"
    },
    "sortBy": {
      "type": "string",
      "enum": [
        "relevance",
        "uploadDate",
        "viewCount",
        "rating"
      ],
      "default": "relevance"
    },
    "uploadDate": {
      "type": "string",
      "enum": [
        "any",
        "lastHour",
        "today",
        "thisWeek",
        "thisMonth",
        "thisYear"
      ],
      "default": "any"
    },
    "duration": {
      "type": "string",
      "enum": [
        "any",
        "short",
        "medium",
        "long"
      ],
      "default": "any"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "live",
          "fourK",
          "hd",
          "subtitles",
          "creativeCommons",
          "threeSixty",
          "vr180",
          "threeD",
          "hdr",
          "location",
          "purchased"
        ]
      },
      "default": []
    },
    "country": {
      "type": "string",
      "default": "US"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "fallbackMode": {
      "type": "string",
      "enum": [
        "auto",
        "never",
        "always"
      ],
      "default": "auto"
    }
  },
  "required": [
    "searchQueries"
  ],
  "additionalProperties": false,
  "title": "youtube-search-scraper: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
