{
  "type": "object",
  "properties": {
    "instagramUsernames": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "directPostUrls": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "maxPostsPerTarget": {
      "type": "integer",
      "default": 50,
      "minimum": 1,
      "maximum": 500
    },
    "onlyPostsNewerThan": {
      "type": "string"
    },
    "includeRecentComments": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [],
  "additionalProperties": false,
  "title": "instagram-posts-scraper: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
