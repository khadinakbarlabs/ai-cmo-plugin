{
  "type": "object",
  "properties": {
    "queries": {
      "type": "array",
      "default": [
        "apify web scraping"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "startUrls": {
      "type": "array",
      "default": [],
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "maxResultsPages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 1
    },
    "resultsPerPage": {
      "type": "integer",
      "minimum": 10,
      "maximum": 100,
      "default": 10
    },
    "countryCode": {
      "type": "string",
      "default": "US",
      "maxLength": 5
    },
    "languageCode": {
      "type": "string",
      "default": "en",
      "maxLength": 10
    },
    "includeAds": {
      "type": "boolean",
      "default": true
    },
    "includeFeaturedSnippet": {
      "type": "boolean",
      "default": true
    },
    "includePeopleAlsoAsk": {
      "type": "boolean",
      "default": true
    },
    "includeRelatedSearches": {
      "type": "boolean",
      "default": true
    },
    "includeKnowledgeGraph": {
      "type": "boolean",
      "default": true
    },
    "maxConcurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 5
    }
  },
  "required": [],
  "additionalProperties": false,
  "title": "scrape-google-serp: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
