{
  "type": "object",
  "properties": {
    "targetDomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 700
      }
    },
    "locationCode": {
      "type": "integer",
      "default": 2840,
      "minimum": 1
    },
    "languageCode": {
      "type": "string",
      "default": "en",
      "pattern": "^[a-zA-Z]{2,5}$"
    },
    "device": {
      "type": "string",
      "default": "desktop",
      "enum": [
        "desktop",
        "mobile"
      ]
    },
    "os": {
      "type": "string",
      "default": "windows",
      "enum": [
        "windows",
        "macos",
        "android",
        "ios"
      ]
    },
    "depth": {
      "type": "integer",
      "default": 10,
      "minimum": 10,
      "maximum": 20
    },
    "maxKeywords": {
      "type": "integer",
      "default": 25,
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "keywords",
    "targetDomain"
  ],
  "additionalProperties": false,
  "title": "keyword-rank-tracker: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
