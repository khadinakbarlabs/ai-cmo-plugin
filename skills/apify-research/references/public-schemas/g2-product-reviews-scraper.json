{
  "type": "object",
  "properties": {
    "startUrls": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "searchQuery": {
      "type": "string"
    },
    "maxReviewsPerProduct": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "maxProductsPerSearch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "includeReviews": {
      "type": "boolean",
      "default": true
    },
    "sortReviewsBy": {
      "type": "string",
      "enum": [
        "newest",
        "helpful"
      ],
      "default": "newest"
    },
    "debug": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [],
  "additionalProperties": false,
  "title": "g2-product-reviews-scraper: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
