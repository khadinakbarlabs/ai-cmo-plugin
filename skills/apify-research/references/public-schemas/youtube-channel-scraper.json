{
  "type": "object",
  "properties": {
    "channelUrls": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "string"
          },
          {
            "not": {
              "type": "string",
              "pattern": "^\\s*[hH][tT][tT][pP][sS]?://[^/?#]*(?:@|%40)"
            }
          }
        ]
      }
    },
    "maxVideosPerChannel": {
      "type": "integer",
      "default": 5,
      "minimum": 0,
      "maximum": 100
    },
    "includeShorts": {
      "type": "boolean",
      "default": false
    },
    "maxShortsPerChannel": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "maximum": 50
    },
    "sortVideosBy": {
      "type": "string",
      "enum": [
        "latest",
        "popular"
      ],
      "default": "latest"
    },
    "providerMode": {
      "type": "string",
      "enum": [
        "auto",
        "direct",
        "providerOnly"
      ],
      "default": "auto"
    },
    "country": {
      "type": "string",
      "default": "US",
      "minLength": 2,
      "maxLength": 2
    },
    "language": {
      "type": "string",
      "default": "en",
      "minLength": 2,
      "maxLength": 8
    }
  },
  "required": [
    "channelUrls"
  ],
  "additionalProperties": false,
  "title": "youtube-channel-scraper: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
