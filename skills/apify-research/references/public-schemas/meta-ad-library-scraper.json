{
  "type": "object",
  "properties": {
    "searchQuery": {
      "type": "string"
    },
    "searchQueries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "countries": {
      "type": "array",
      "default": [
        "US"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "adStatus": {
      "type": "string",
      "enum": [
        "ALL",
        "ACTIVE",
        "INACTIVE"
      ],
      "default": "ALL"
    },
    "adType": {
      "type": "string",
      "enum": [
        "ALL"
      ],
      "default": "ALL"
    },
    "mediaType": {
      "type": "string",
      "enum": [
        "ALL",
        "IMAGE",
        "VIDEO",
        "MEME",
        "NONE"
      ],
      "default": "ALL"
    },
    "startDate": {
      "type": "string"
    },
    "endDate": {
      "type": "string"
    },
    "maxResults": {
      "type": "integer",
      "default": 100,
      "minimum": 1,
      "maximum": 50000
    },
    "sortBy": {
      "type": "string",
      "enum": [
        "impressions_desc",
        "most_recent"
      ],
      "default": "impressions_desc"
    },
    "enrichAds": {
      "type": "boolean",
      "default": true
    },
    "providerFallbackEnabled": {
      "type": "boolean",
      "default": false,
      "const": false
    },
    "onlyCount": {
      "type": "boolean",
      "default": false
    },
    "advertiserPageIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "startUrls": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "adId": {
      "type": "string"
    },
    "contentLanguages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publisherPlatforms": {
      "type": "array",
      "default": [
        "facebook",
        "instagram"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "searchType": {
      "type": "string",
      "enum": [
        "KEYWORD_UNORDERED",
        "KEYWORD_EXACT_PHRASE"
      ],
      "default": "KEYWORD_UNORDERED"
    }
  },
  "required": [
    "providerFallbackEnabled"
  ],
  "additionalProperties": false,
  "title": "meta-ad-library-scraper: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
