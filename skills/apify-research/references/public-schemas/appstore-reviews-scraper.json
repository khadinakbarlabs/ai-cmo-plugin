{
  "$schema": "https://apify.com/schemas/v1/input.ide.json",
  "type": "object",
  "properties": {
    "appIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 100,
      "default": [
        "324684580"
      ]
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 2
      },
      "uniqueItems": true,
      "maxItems": 175,
      "default": [
        "us"
      ]
    },
    "sortBy": {
      "type": "string",
      "enum": [
        "mostRecent",
        "mostHelpful"
      ],
      "default": "mostRecent"
    },
    "maxReviewsPerApp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 500
    },
    "maxReviews": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50000,
      "default": 1000
    },
    "ratingFilter": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "uniqueItems": true,
      "maxItems": 5,
      "default": []
    },
    "dateFrom": {
      "type": "string",
      "default": ""
    },
    "dateTo": {
      "type": "string",
      "default": ""
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "maxItems": 50,
      "default": []
    },
    "minVoteSum": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  },
  "required": [
    "appIds"
  ],
  "additionalProperties": false,
  "title": "appstore-reviews-scraper: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
