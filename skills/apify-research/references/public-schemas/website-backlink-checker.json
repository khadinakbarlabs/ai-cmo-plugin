{
  "$schema": "https://apify.com/schemas/v1/input.ide.json",
  "type": "object",
  "properties": {
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "backlinks",
        "referring_domains",
        "anchors",
        "summary"
      ],
      "default": "backlinks"
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 5
    },
    "dofollowOnly": {
      "type": "boolean",
      "default": false
    },
    "excludeLost": {
      "type": "boolean",
      "default": true
    },
    "includeSubdomains": {
      "type": "boolean",
      "default": true
    },
    "excludeInternalBacklinks": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "targets"
  ],
  "additionalProperties": false,
  "title": "website-backlink-checker: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
