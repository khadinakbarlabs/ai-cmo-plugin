        "RU:ru",
        "JP:ja",
        "CN:zh-Hans",
        "TW:zh-Hant",
        "KR:ko",
        "SA:ar",
        "EG:ar",
        "TR:tr",
        "IL:he",
        "SE:sv",
        "NO:no",
        "DK:da",
        "FI:fi",
