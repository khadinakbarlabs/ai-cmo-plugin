{
  "type": "object",
  "properties": {
    "searchQueries": {
      "type": "array",
      "placeholderValue": "e.g. artificial intelligence, \"Federal Reserve\" rate hike, Tesla -musk site:bloomberg.com",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "WORLD",
          "NATION",
          "BUSINESS",
          "TECHNOLOGY",
          "ENTERTAINMENT",
          "SPORTS",
          "SCIENCE",
          "HEALTH"
        ]
      }
    },
    "topicUrls": {
      "type": "array",
      "placeholderValue": "e.g. https://news.google.com/topics/CAAqJggKIiBDQkFTRWdvSUwyMHZNRGRqTVhZU0FtVnVHZ0pWVXlnQVAB",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "startUrls": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "maxResultsPerQuery": {
      "type": "integer",
      "default": 100,
      "minimum": 1,
      "maximum": 100
    },
    "regionLanguage": {
      "type": "string",
      "default": "US:en",
      "enum": [
        "US:en",
        "GB:en",
        "AU:en",
        "CA:en",
        "IN:en",
        "DE:de",
        "AT:de",
        "CH:de",
