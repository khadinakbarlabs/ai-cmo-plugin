        "1h",
        "1d",
        "7d",
        "30d",
        "1y"
      ]
    },
    "extractFullText": {
      "type": "boolean",
      "default": false
    },
    "decodeUrls": {
      "type": "boolean",
      "default": false
    },
    "deduplicateResults": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [],
  "additionalProperties": false,
  "title": "google-news-scraper: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
