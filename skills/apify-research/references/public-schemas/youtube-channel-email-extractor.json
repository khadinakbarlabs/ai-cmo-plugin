      "default": [
        "https://www.youtube.com/@aliabdaal"
      ],
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "searchQueries": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxResults": {
      "type": "integer",
      "default": 100,
      "minimum": 1,
      "maximum": 10000
    },
    "scrapeWebsite": {
      "type": "boolean",
      "default": true
    },
    "followLinkAggregators": {
      "type": "boolean",
      "default": true
    },
    "unlockBusinessInquiryEmail": {
      "type": "boolean",
      "default": false,
      "const": false
    }
  },
  "required": [
    "unlockBusinessInquiryEmail"
  ],
  "additionalProperties": false,
  "title": "youtube-channel-email-extractor: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
