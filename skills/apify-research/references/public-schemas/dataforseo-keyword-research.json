{
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "default": "keyword_ideas",
      "enum": [
        "keyword_ideas",
        "search_volume"
      ]
    },
    "seedKeywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "locationCode": {
      "type": "integer",
      "default": 2840,
      "minimum": 1
    },
    "languageCode": {
      "type": "string",
      "default": "en",
      "pattern": "^[a-zA-Z]{2,5}$"
    },
    "maxResults": {
      "type": "integer",
      "default": 25,
      "minimum": 1,
      "maximum": 50
    },
    "minSearchVolume": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "maximum": 10000000
    },
    "includeSerpInfo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "seedKeywords"
  ],
  "additionalProperties": false,
  "title": "dataforseo-keyword-research: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
