{
  "$schema": "https://apify.com/schemas/v1/input.ide.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "country": {
      "type": "string",
      "enum": [
        "AT",
        "BE",
        "BG",
        "BR",
        "HR",
        "CY",
        "CZ",
        "DK",
        "EE",
        "FI",
        "FR",
        "DE",
        "GR",
        "HU",
        "IE",
        "IT",
        "LV",
        "LT",
        "LU",
        "MT",
        "NL",
        "NO",
        "PL",
        "PT",
        "RO",
        "SK",
        "SI",
        "ES",
        "SE",
        "TR"
      ],
      "default": "FR"
    },
    "startDate": {
      "type": "string"
    },
    "endDate": {
      "type": "string"
    },
    "advertiserName": {
      "type": "string",
      "maxLength": 200
    },
    "category": {
      "type": "string",
      "enum": [
        "ALL",
        "ANIMALS",
        "ARCHITECTURE",
        "ART",
        "BEAUTY",
        "CHILDRENS_FASHION",
        "DESIGN",
        "DIY_AND_CRAFTS",
        "EDUCATION",
        "ELECTRONICS",
        "ENTERTAINMENT",
        "EVENT_PLANNING",
        "FINANCE",
        "FOOD_AND_DRINKS",
        "GARDENING",
        "HEALTH",
        "HOME_DECOR",
        "MENS_FASHION",
        "OTHER",
        "PARENTING",
        "QUOTES",
        "SPORT",
        "TRAVEL",
        "VEHICLES",
        "WEDDING",
        "WOMENS_FASHION"
      ],
      "default": "ALL"
    },
    "gender": {
      "type": "string",
      "enum": [
        "ALL",
        "FEMALE",
        "MALE",
        "UNSPECIFIED"
      ],
      "default": "ALL"
    },
    "age": {
      "type": "string",
      "enum": [
        "ALL",
        "AGE_18_24",
        "AGE_25_34",
        "AGE_35_44",
        "AGE_45_49",
        "AGE_50_54",
        "AGE_55_64",
        "AGE_65_PLUS"
      ],
      "default": "ALL"
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24,
      "default": 24
    },
    "requestTimeoutSecs": {
      "type": "integer",
      "minimum": 20,
      "maximum": 120,
      "default": 60
    }
  },
  "required": [],
  "title": "pinterest-ads-library-scraper: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
