{
  "$schema": "https://apify.com/schemas/v1/input.ide.json",
  "type": "object",
  "properties": {
    "startUrls": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^/@\\s]+(?:[/?#]|$)"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "placeIds": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dataIds": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "searchQuery": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "maxReviews": {
      "type": "integer",
      "default": 100,
      "minimum": 1,
      "maximum": 5000
    },
    "reviewsSort": {
      "type": "string",
      "enum": [
        "newest",
        "mostRelevant",
        "highestRanking",
        "lowestRanking"
      ],
      "default": "newest"
    },
    "reviewSearchQuery": {
      "type": "string",
      "default": ""
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "fr",
        "de",
        "it",
        "pt",
        "nl",
        "pl",
        "ru",
        "ja",
        "ko",
        "zh-CN",
        "ar",
        "tr",
        "hi",
        "id",
        "vi",
        "th",
        "sv",
        "no",
        "da",
        "fi",
        "cs",
        "el",
        "he"
      ],
      "default": "en"
    },
    "countryCode": {
      "type": "string",
      "default": "US"
    },
    "includePersonalData": {
      "type": "boolean",
      "default": false,
      "const": false
    }
  },
  "required": [
    "includePersonalData"
  ],
  "additionalProperties": false,
  "title": "google-maps-reviews-scraper: supported public research inputs",
  "description": "Constrained plugin input projection, not the complete upstream Actor schema. Consult execution_profile before any launch.",
  "x-ai-cmo-profile": "public-research-projection-v1"
}
