{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "business_id",
    "campaign_id",
    "goal",
    "tasks",
    "next_decision"
  ],
  "properties": {
    "business_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "goal",
          "dependencies",
          "status",
          "acceptance",
          "artifacts",
          "evidence",
          "next_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "enum": [
              "cmo",
              "market-intelligence",
              "search-strategist",
              "campaign-producer",
              "growth-analyst",
              "campaign-reviewer",
              "cli-operator"
            ]
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "queued",
              "ready",
              "running",
              "review",
              "needs-revision",
              "done",
              "blocked"
            ]
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "review_decision": {
            "enum": [
              "pass",
              "revise",
              "blocked"
            ]
          }
        }
      }
    },
    "next_decision": {
      "type": "string",
      "minLength": 1
    }
  }
}
