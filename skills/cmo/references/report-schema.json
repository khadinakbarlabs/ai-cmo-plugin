{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "business_id": {
      "type": "string",
      "minLength": 1
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "observed",
        "partial",
        "data-unavailable"
      ]
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "observed",
              "estimated",
              "unknown"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "numerator": {
            "type": [
              "number",
              "null"
            ]
          },
          "denominator": {
            "type": [
              "number",
              "null"
            ]
          },
          "comparison_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "comparison_period": {
            "type": [
              "string",
              "null"
            ]
          },
          "calculation": {
            "enum": [
              "direct",
              "ratio",
              "percentage"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "value",
          "unit",
          "state",
          "definition",
          "source",
          "numerator",
          "denominator",
          "comparison_value",
          "comparison_period",
          "calculation"
        ]
      }
    },
    "completed_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "feedback_summary": {
      "type": "string",
      "minLength": 1
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "review_at": {
      "type": "string",
      "format": "date-time"
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "business_id",
    "report_id",
    "period",
    "timezone",
    "observed_at",
    "goal",
    "status",
    "headline",
    "metrics",
    "completed_outputs",
    "blockers",
    "feedback_summary",
    "next_action",
    "review_at",
    "limits"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
