{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "business_id",
    "campaign_id",
    "role",
    "objective",
    "plugin_root",
    "resource_paths",
    "input_sources",
    "output_paths",
    "acceptance",
    "authority",
    "limits"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "business_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "market-intelligence",
        "search-strategist",
        "campaign-producer",
        "growth-analyst",
        "campaign-reviewer",
        "cli-operator"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "plugin_root": {
      "type": "string",
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
      "minLength": 1
    },
    "resource_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
        "minLength": 1
      }
    },
    "input_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_effects",
        "source",
        "cost_limit_usd"
      ],
      "properties": {
        "allowed_effects": {
          "type": "array",
          "items": {
            "enum": [
              "read-supplied",
              "public-research",
              "local-draft",
              "paid-research",
              "publish",
              "send",
              "spend-change"
            ]
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "cost_limit_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_turns",
        "write_scope"
      ],
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "write_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authority": {
            "properties": {
              "allowed_effects": {
                "contains": {
                  "enum": [
                    "paid-research",
                    "spend-change"
                  ]
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "cost_limit_usd": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  ]
}
